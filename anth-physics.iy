-- ANTH Physics v1.4 - Infinite Yield plugin
-- Commands: ;blackhole [player] ;unblackhole ;tornado [player] ;untornado ;nuke [player] ;kill [player] ;wand ;ping
-- Works in IY command prompt AND in chat with ; or / prefix.
-- v1.4 fixes: BH/TOR were flinging YOU on NDS islands - they pulled huge island
-- parts and parts you were standing on, and pulled parts straight through you.
-- Now: parts over 20 studs are skipped, the part under your feet is skipped,
-- centre is 25 studs ahead of you (not 10), parts within 5 studs of you are
-- skipped, and your own velocity is clamped while BH/TOR run.
-- BH/TOR pull is now much stronger and instant-feeling: velocity scales with
-- distance up to 800, and parts within 200 studs are also lerped toward the
-- target each tick. Nuke now also throws parts AT the target as projectiles.
-- New: ;kill [player] slams unanchored blocks into the target fast, repeatedly.
-- Install: run the writefile line in Delta before IY, then ;addplugin anth-physics
-- v1.2 recheck: v1.1 removed the chat listener, so if IY did not register a
-- command, or you typed /blackhole in chat, nothing happened at all, with no
-- message to tell you why. v1.2 adds back a chat listener for BOTH ; and /
-- with a 1s debounce so IY + chat do not double-run, plus ;ping and a load
-- message so you can see the plugin actually loaded, plus a loose-part count
-- on blackhole/tornado so you know when a map has almost nothing to pull.
-- HONEST LIMIT, read this:
-- These are NOT true server-side. No client script can own the server.
-- They work because Roblox gives YOUR client network ownership of
-- unanchored parts near you, and physics on those parts replicates
-- to everyone. Parts 5000 studs away you almost certainly do NOT
-- own, so they will not move until ownership shifts to you.
-- 5000 studs is the range you asked for, but it will be laggy in
-- big maps - the plugin batches parts (300 per tick) so it does
-- not freeze your game. Same for players: other characters are
-- owned by the server / themselves, so flinging them is best
-- effort only, never guaranteed.
-- NUKE BUG FIX (old ANTH Hub):
-- Old ;nuke put 3 Explosions ON your own HRP. An Explosion you
-- create flings YOU (you own your own character), but it does
-- not move other players, and a single AssemblyLinearVelocity
-- set on their HRP gets overwritten by the server. So only you
-- exploded. New nuke: centre is 25 studs IN FRONT of you (or
-- on the target), YOU are excluded from the fling loop, your
-- velocity is zeroed after, and every other player in 1000
-- studs gets velocity + BodyVelocity + spin + an Explosion at
-- THEIR position, repeated 12 times over 1.2s.

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

local RANGE = 5000
local NUKE_RADIUS = 1000
local MAX_PER_TICK = 300

local function getHRP()
	local c = LocalPlayer.Character
	if c then return c:FindFirstChild("HumanoidRootPart") end
	return nil
end
local function findPlayer(name)
	if not name or name == "" then return nil end
	name = string.lower(name)
	if name == "me" then return LocalPlayer end
	if name == "nearest" or name == "closest" then
		local hrp = getHRP()
		if not hrp then return nil end
		local best, bestD = nil, math.huge
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= LocalPlayer and p.Character then
				local h = p.Character:FindFirstChild("HumanoidRootPart")
				if h then
					local d = (h.Position - hrp.Position).Magnitude
					if d < bestD then bestD, best = d, p end
				end
			end
		end
		return best
	end
	if name == "random" then
		local list = {}
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= LocalPlayer then table.insert(list, p) end
		end
		if #list > 0 then return list[math.random(1, #list)] end
		return nil
	end
	for _, p in ipairs(Players:GetPlayers()) do
		if string.sub(string.lower(p.Name), 1, #name) == name then return p end
		if string.sub(string.lower(p.DisplayName), 1, #name) == name then return p end
	end
	return nil
end
local function getMyFloorPart()
	local hrp = getHRP()
	if not hrp then return nil end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local char = LocalPlayer.Character
	if char then params.FilterDescendantsInstances = {char} end
	local result = Workspace:Raycast(hrp.Position, Vector3.new(0, -6, 0), params)
	if result and result.Instance then return result.Instance end
	return nil
end
local function getUnanchored()
	local list = {}
	local floorPart = getMyFloorPart()
	for _, o in ipairs(Workspace:GetDescendants()) do
		if o:IsA("BasePart") and not o.Anchored then
			if o.Name ~= "ANTH_BHCenter" and o.Name ~= "ANTH_TORCenter" and o.Name ~= "ANTH_NukeFlash" then
				if o ~= floorPart and o.Size.Magnitude <= 20 then
					local isChar = false
					for _, plr in ipairs(Players:GetPlayers()) do
						if plr.Character and o:IsDescendantOf(plr.Character) then
							isChar = true
							break
						end
					end
					if not isChar then
						table.insert(list, o)
					end
				end
			end
		end
	end
	return list
end
local function notify(msg)
	pcall(function()
		game:GetService("StarterGui"):SetCore("ChatMakeSystemMessage", {Text = "[ANTH Physics] " .. msg, Color = Color3.fromRGB(0, 255, 100)})
	end)
	print("[ANTH Physics] " .. msg)
end

-- ================= STATE =================
local BHActive = false
local BHTarget = nil
local BHCenterPos = nil
local BHPart = nil
local RingSlots = {}
local RingCount = 0
local TORActive = false
local TORTarget = nil
local TORCenterPos = nil
local TORPart = nil
local PartCursor = 1
local CachedParts = {}

task.spawn(function()
	while true do
		task.wait(0.5)
		CachedParts = getUnanchored()
		PartCursor = 1
	end
end)

local function stopBH()
	BHActive = false
	if BHPart then BHPart:Destroy() BHPart = nil end
	RingSlots = {}
	RingCount = 0
end
local function stopTOR()
	TORActive = false
	if TORPart then TORPart:Destroy() TORPart = nil end
end
local function startBH(target)
	stopBH()
	BHTarget = target
	local hrp = getHRP()
	if target and target.Character then
		local th = target.Character:FindFirstChild("HumanoidRootPart")
		if th then BHCenterPos = th.Position end
	end
	if not BHCenterPos then
		if hrp then BHCenterPos = hrp.Position + hrp.CFrame.LookVector * 25 else BHCenterPos = Vector3.new(0, 10, 0) end
	end
	BHActive = true
	local v = Instance.new("Part")
	v.Name = "ANTH_BHCenter"
	v.Anchored = true
	v.CanCollide = false
	v.CanQuery = false
	v.Size = Vector3.new(6, 6, 6)
	v.Shape = Enum.PartType.Ball
	v.Material = Enum.Material.Neon
	v.Color = Color3.fromRGB(5, 5, 5)
	v.Transparency = 0.1
	v.Parent = Workspace
	BHPart = v
	local n = #getUnanchored()
	if target then notify("Blackhole ON - on " .. target.DisplayName .. " - pulling " .. tostring(n) .. " loose parts in 5000 studs") else notify("Blackhole ON - pulling " .. tostring(n) .. " loose parts in 5000 studs - anchored map parts will not move") end
end
local function startTOR(target)
	stopTOR()
	TORTarget = target
	local hrp = getHRP()
	if target and target.Character then
		local th = target.Character:FindFirstChild("HumanoidRootPart")
		if th then TORCenterPos = th.Position end
	end
	if not TORCenterPos then
		if hrp then TORCenterPos = hrp.Position + hrp.CFrame.LookVector * 25 else TORCenterPos = Vector3.new(0, 10, 0) end
	end
	TORActive = true
	local v = Instance.new("Part")
	v.Name = "ANTH_TORCenter"
	v.Anchored = true
	v.CanCollide = false
	v.CanQuery = false
	v.Size = Vector3.new(10, 120, 10)
	v.Shape = Enum.PartType.Cylinder
	v.Material = Enum.Material.Neon
	v.Color = Color3.fromRGB(200, 200, 220)
	v.Transparency = 0.75
	v.Parent = Workspace
	TORPart = v
	local n = #getUnanchored()
	if target then notify("Tornado ON - on " .. target.DisplayName .. " - pulling " .. tostring(n) .. " loose parts in 5000 studs") else notify("Tornado ON - pulling " .. tostring(n) .. " loose parts in 5000 studs - anchored map parts will not move") end
end

-- ================= ANTH WAND =================
local WandTool = nil
local WandHeld = nil
local throwWand
local ThrowBtn = nil
local function ensureThrowButton()
	if ThrowBtn and ThrowBtn.Parent then return end
	local pg = LocalPlayer:FindFirstChild("PlayerGui")
	if not pg then return end
	local gui = Instance.new("ScreenGui")
	gui.Name = "ANTH_WandThrow"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.Parent = pg
	local btn = Instance.new("TextButton")
	btn.Name = "ThrowBtn"
	btn.Text = "THROW"
	btn.Size = UDim2.new(0, 90, 0, 36)
	btn.Position = UDim2.new(1, -100, 1, -140)
	btn.AnchorPoint = Vector2.new(0, 0)
	btn.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
	btn.TextColor3 = Color3.fromRGB(0, 255, 100)
	btn.Font = Enum.Font.GothamBold
	btn.TextSize = 16
	btn.Visible = false
	btn.BorderSizePixel = 1
	btn.BorderColor3 = Color3.fromRGB(0, 255, 100)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = btn
	btn.Parent = gui
	btn.MouseButton1Click:Connect(function() throwWand() end)
	ThrowBtn = btn
end
local function clearWandHold()
	if WandHeld and WandHeld.Parent then
		pcall(function() WandHeld.AssemblyLinearVelocity = Vector3.new(0, 0, 0) end)
	end
	WandHeld = nil
end
local function giveWand()
	if WandTool and WandTool.Parent then
		notify("ANTH Wand - you already have it, check your backpack")
		return
	end
	local tool = Instance.new("Tool")
	tool.Name = "ANTH Wand"
	tool.RequiresHandle = true
	tool.CanBeDropped = false
	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(0.4, 0.4, 3)
	handle.Material = Enum.Material.Neon
	handle.Color = Color3.fromRGB(0, 255, 100)
	handle.CanCollide = false
	handle.Massless = true
	handle.Parent = tool
	local tip = Instance.new("Part")
	tip.Name = "Tip"
	tip.Size = Vector3.new(0.8, 0.8, 0.8)
	tip.Shape = Enum.PartType.Ball
	tip.Material = Enum.Material.Neon
	tip.Color = Color3.fromRGB(0, 255, 255)
	tip.CanCollide = false
	tip.Massless = true
	tip.CFrame = CFrame.new(0, 0, -1.8)
	local weld = Instance.new("Weld")
	weld.Part0 = handle
	weld.Part1 = tip
	weld.C0 = CFrame.new(0, 0, -1.8)
	weld.Parent = handle
	tip.Parent = tool
	tool.Activated:Connect(function()
		if WandHeld then
			clearWandHold()
			notify("Wand - dropped part")
			return
		end
		local mouse = LocalPlayer:GetMouse()
		local target = nil
		if mouse and mouse.Target and mouse.Target:IsA("BasePart") then
			target = mouse.Target
		end
		if not target or target.Anchored then
			local hrp = getHRP()
			if hrp then
				local best, bestD = nil, 40
				for _, part in ipairs(getUnanchored()) do
					local d = (part.Position - hrp.Position).Magnitude
					if d < bestD then bestD, best = d, part end
				end
				target = best
			end
		end
		if not target then
			notify("Wand - tap a loose part, or get closer to one")
			return
		end
		if target.Anchored then
			notify("Wand - that part is anchored, it will not move")
			return
		end
		local isChar = false
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr.Character and target:IsDescendantOf(plr.Character) then isChar = true break end
		end
		if isChar then
			notify("Wand - that is a player, not a part")
			return
		end
		if target.Size.Magnitude > 8 then
			notify("Wand - that part is too big, tap a small loose part")
			return
		end
		WandHeld = target
		notify("Wand - grabbed " .. target.Name .. " - tap again to drop, tap THROW button to throw it")
	end)
	tool.Unequipped:Connect(function()
		clearWandHold()
		if ThrowBtn then ThrowBtn.Visible = false end
	end)
	tool.Equipped:Connect(function()
		ensureThrowButton()
		if ThrowBtn then ThrowBtn.Visible = true end
	end)
	tool.Parent = LocalPlayer.Backpack
	WandTool = tool
	ensureThrowButton()
	notify("ANTH Wand given - equip it, tap a small loose part to grab it, tap the THROW button to throw it")
end
throwWand = function()
	if not WandHeld or not WandHeld.Parent then
		notify("Wand - you are not holding anything, tap a part first")
		return
	end
	local hrp = getHRP()
	local dir = Vector3.new(0, 0, -1)
	if hrp then dir = hrp.CFrame.LookVector end
	local part = WandHeld
	clearWandHold()
	pcall(function()
		part.AssemblyLinearVelocity = dir * 120 + Vector3.new(0, 40, 0)
		part.AssemblyAngularVelocity = Vector3.new(math.random(-30, 30), math.random(-30, 30), math.random(-30, 30))
	end)
	notify("Wand - THREW " .. part.Name)
end
local function removeWand()
	clearWandHold()
	if ThrowBtn then ThrowBtn.Visible = false end
	if WandTool then WandTool:Destroy() WandTool = nil end
	notify("ANTH Wand removed")
end
RunService.Heartbeat:Connect(function()
	if WandHeld and WandHeld.Parent then
		local hrp = getHRP()
		if hrp then
			local want = hrp.Position + hrp.CFrame.LookVector * 8 + Vector3.new(0, 2, 0)
			local off = want - WandHeld.Position
			pcall(function()
				WandHeld.AssemblyLinearVelocity = off * 12
				WandHeld.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
			end)
		end
	else
		WandHeld = nil
	end
end)

-- One shared Heartbeat loop, batched so 5000 studs does not freeze you
RunService.Heartbeat:Connect(function()
	if not BHActive and not TORActive then return end
	-- SELF PROTECTION: BH/TOR must never fling you. Clamp your own velocity.
	local myHRP = getHRP()
	if myHRP then
		pcall(function()
			if myHRP.AssemblyLinearVelocity.Magnitude > 60 then
				myHRP.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
			end
		end)
	end
	local bhCenter = nil
	if BHActive then
		if BHTarget and BHTarget.Character then
			local th = BHTarget.Character:FindFirstChild("HumanoidRootPart")
			if th then bhCenter = th.Position end
		end
		if not bhCenter then bhCenter = BHCenterPos end
		if bhCenter and BHPart then BHPart.CFrame = CFrame.new(bhCenter) end
	end
	local torCenter = nil
	if TORActive then
		if TORTarget and TORTarget.Character then
			local th = TORTarget.Character:FindFirstChild("HumanoidRootPart")
			if th then torCenter = th.Position end
		end
		if not torCenter then torCenter = TORCenterPos end
		if torCenter and TORPart then TORPart.CFrame = CFrame.new(torCenter + Vector3.new(0, 60, 0)) * CFrame.Angles(0, 0, math.rad(90)) end
	end
	local n = #CachedParts
	if n == 0 then return end
	local done = 0
	while done < MAX_PER_TICK and n > 0 do
		PartCursor = PartCursor + 1
		if PartCursor > n then PartCursor = 1 end
		local part = CachedParts[PartCursor]
		done = done + 1
		if part and part.Parent then
			-- Never pull a part that is right on top of you, it would hit you
			local tooCloseToMe = false
			if myHRP then
				if (part.Position - myHRP.Position).Magnitude < 5 then tooCloseToMe = true end
			end
			if not tooCloseToMe then
			if BHActive and bhCenter then
				local off = bhCenter - part.Position
				local d = off.Magnitude
				if d > 0.5 and d < RANGE then
					-- Ring: first 80 parts that get close become the accretion ring
					local slot = RingSlots[part]
					if not slot and d < 60 and RingCount < 80 then
						RingCount = RingCount + 1
						slot = {angle = (RingCount / 80) * math.pi * 2, radius = 14 + (RingCount % 3) * 4}
						RingSlots[part] = slot
					end
					if slot then
						slot.angle = slot.angle + 0.12
						local ringPos = bhCenter + Vector3.new(math.cos(slot.angle) * slot.radius, math.sin(slot.angle * 3) * 2, math.sin(slot.angle) * slot.radius)
						local dir = ringPos - part.Position
						if dir.Magnitude > 0.5 then
							pcall(function() part.AssemblyLinearVelocity = dir.Unit * 90 end)
						end
					else
						-- INSTANT pull: velocity scales with distance, up to 800,
						-- plus lerp parts within 200 studs straight toward the centre
						local strength = math.clamp(300 + d * 0.8, 200, 800)
						local vel = off.Unit * strength
						local tan = Vector3.new(-off.Z, 0, off.X)
						if tan.Magnitude > 0.1 then vel = vel + tan.Unit * 60 end
						if d < 8 then vel = tan.Unit * 80 + Vector3.new(0, 30, 0) end
						pcall(function() part.AssemblyLinearVelocity = vel end)
						if d < 200 and d > 8 then
							pcall(function() part.CFrame = CFrame.new(part.Position:Lerp(bhCenter, 0.12)) end)
						end
					end
				end
			end
			if TORActive and torCenter then
				local off = part.Position - torCenter
				local flat = Vector3.new(off.X, 0, off.Z).Magnitude
				local height = off.Y
				if flat < RANGE and height > -20 and height < 150 then
					local wantRadius = 6 + math.max(height, 0) * 0.4
					local tan = Vector3.new(-off.Z, 0, off.X)
					if tan.Magnitude < 0.1 then tan = Vector3.new(1, 0, 0) end
					tan = tan.Unit
					local inw = Vector3.new(0, 0, 0)
					if flat > wantRadius + 2 then
						inw = Vector3.new(-off.X, 0, -off.Z).Unit * 80
					elseif flat < wantRadius - 2 then
						inw = Vector3.new(off.X, 0, off.Z).Unit * 20
					end
					local up = 80
					if height > 110 then up = -30 end
					pcall(function() part.AssemblyLinearVelocity = tan * 150 + inw + Vector3.new(0, up, 0) end)
					if flat < 200 then
						pcall(function()
							local want = torCenter + Vector3.new(off.X * 0.85, off.Y, off.Z * 0.85)
							part.CFrame = CFrame.new(part.Position:Lerp(want, 0.1))
						end)
					end
				end
			end
			end
		end
	end
end)

local function flingPlayersFrom(pos, radius, power)
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer and plr.Character then
			local ph = plr.Character:FindFirstChild("HumanoidRootPart")
			if ph then
				local off = ph.Position - pos
				local d = off.Magnitude
				if d < radius then
					local dir = Vector3.new(0, 1, 0)
					if d > 0.5 then dir = off.Unit end
					-- Repeat 20 times over 2s: a single set gets overwritten by the server
					task.spawn(function()
						for i = 1, 20 do
							pcall(function()
								ph.AssemblyLinearVelocity = dir * power + Vector3.new(0, power * 0.7, 0)
								local bv = ph:FindFirstChild("ANTH_NukeBV")
								if not bv then
									bv = Instance.new("BodyVelocity")
									bv.Name = "ANTH_NukeBV"
									bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
									bv.Parent = ph
								end
								bv.Velocity = dir * power + Vector3.new(0, power * 0.7, 0)
								local av = ph:FindFirstChild("ANTH_NukeAV")
								if not av then
									av = Instance.new("BodyAngularVelocity")
									av.Name = "ANTH_NukeAV"
									av.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
									av.AngularVelocity = Vector3.new(0, 150, 0)
									av.Parent = ph
								end
							end)
							task.wait(0.1)
						end
						task.wait(1)
						pcall(function()
							local bv = ph:FindFirstChild("ANTH_NukeBV")
							if bv then bv:Destroy() end
							local av = ph:FindFirstChild("ANTH_NukeAV")
							if av then av:Destroy() end
						end)
					end)
					-- Explosion AT them, not at you
					pcall(function()
						local ex = Instance.new("Explosion")
						ex.Position = ph.Position
						ex.BlastRadius = 20
						ex.BlastPressure = 1000000
						ex.DestroyJointRadiusPercent = 1
						ex.Parent = Workspace
					end)
				end
			end
		end
	end
end

-- Slam unanchored parts into a target, fast, repeatedly.
-- This is the part that actually hurts/flings them: parts YOU own colliding
-- with their character replicates, setting their velocity directly often does not.
local function slamPartsAt(target, seconds)
	if not target or not target.Character then return end
	local th = target.Character:FindFirstChild("HumanoidRootPart")
	if not th then return end
	task.spawn(function()
		local parts = {}
		for _, part in ipairs(getUnanchored()) do
			if #parts >= 20 then break end
			if (part.Position - th.Position).Magnitude < 150 then
				table.insert(parts, part)
			end
		end
		if #parts == 0 then
			for _, part in ipairs(getUnanchored()) do
				if #parts >= 20 then break end
				table.insert(parts, part)
			end
		end
		local start = os.clock()
		while os.clock() - start < seconds do
			local tHRP = target.Character and target.Character:FindFirstChild("HumanoidRootPart")
			if not tHRP then break end
			for _, part in ipairs(parts) do
				if part and part.Parent then
					pcall(function()
						part.CFrame = CFrame.new(tHRP.Position + Vector3.new(math.random(-4, 4), math.random(2, 6), math.random(-4, 4)))
						part.AssemblyLinearVelocity = Vector3.new(math.random(-100, 100), 200, math.random(-100, 100))
						part.AssemblyAngularVelocity = Vector3.new(math.random(-100, 100), math.random(-100, 100), math.random(-100, 100))
					end)
				end
			end
			task.wait(0.1)
		end
	end)
end

local function doKill(target)
	if not target then
		notify("Kill - pick a target: ;kill bacon")
		return
	end
	if target == LocalPlayer then
		notify("Kill - you cannot kill yourself with this")
		return
	end
	notify("KILL on " .. target.DisplayName .. " - slamming blocks into them")
	slamPartsAt(target, 3)
	-- Explosions at them, repeatedly, plus direct fling attempts
	task.spawn(function()
		for i = 1, 15 do
			local tHRP = target.Character and target.Character:FindFirstChild("HumanoidRootPart")
			if not tHRP then break end
			pcall(function()
				local ex = Instance.new("Explosion")
				ex.Position = tHRP.Position
				ex.BlastRadius = 12
				ex.BlastPressure = 1000000
				ex.DestroyJointRadiusPercent = 1
				ex.Parent = Workspace
				tHRP.AssemblyLinearVelocity = Vector3.new(math.random(-200, 200), 400, math.random(-200, 200))
			end)
			task.wait(0.2)
		end
	end)
end

local function doNuke(target)
	local hrp = getHRP()
	local c = nil
	if target and target.Character then
		local th = target.Character:FindFirstChild("HumanoidRootPart")
		if th then c = th.Position end
	end
	if not c then
		if hrp then c = hrp.Position + hrp.CFrame.LookVector * 25 else c = Vector3.new(0, 10, 0) end
	end
	-- Big flash, centred on the blast, NOT on you
	local flash = Instance.new("Part")
	flash.Name = "ANTH_NukeFlash"
	flash.Anchored = true
	flash.CanCollide = false
	flash.CanQuery = false
	flash.Size = Vector3.new(10, 10, 10)
	flash.Shape = Enum.PartType.Ball
	flash.Material = Enum.Material.Neon
	flash.Color = Color3.fromRGB(255, 140, 0)
	flash.CFrame = CFrame.new(c)
	flash.Parent = Workspace
	task.spawn(function()
		for i = 1, 10 do
			if not flash.Parent then break end
			flash.Size = Vector3.new(10 + i * 20, 10 + i * 20, 10 + i * 20)
			flash.Transparency = i / 10
			task.wait(0.05)
		end
		flash:Destroy()
	end)
	for i = 1, 3 do
		local ex = Instance.new("Explosion")
		ex.Position = c + Vector3.new((i - 2) * 15, 0, 0)
		ex.BlastRadius = 100
		ex.BlastPressure = 1000000
		ex.DestroyJointRadiusPercent = 1
		ex.Parent = Workspace
	end
	for _, part in ipairs(getUnanchored()) do
		local off = part.Position - c
		if off.Magnitude < NUKE_RADIUS then
			local dir = Vector3.new(0, 1, 0)
			if off.Magnitude > 0.5 then dir = off.Unit end
			pcall(function()
				part.AssemblyLinearVelocity = dir * 400 + Vector3.new(0, 250, 0)
				part.AssemblyAngularVelocity = Vector3.new(math.random(-60, 60), math.random(-60, 60), math.random(-60, 60))
			end)
		end
	end
	flingPlayersFrom(c, NUKE_RADIUS, 600)
	if target then
		slamPartsAt(target, 2)
	else
		local nearest = findPlayer("nearest")
		if nearest then slamPartsAt(nearest, 2) end
	end
	-- You are excluded above, and your velocity is zeroed so the blast does not fling you
	local myHRP = getHRP()
	if myHRP then
		task.delay(0.2, function()
			pcall(function() myHRP.AssemblyLinearVelocity = Vector3.new(0, 0, 0) end)
		end)
	end
	if target then notify("NUKE on " .. target.DisplayName .. " - 1000 studs") else notify("NUKE! 1000 studs - centred 25 studs ahead of you, NOT on you") end
end

