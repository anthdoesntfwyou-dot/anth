				notify("ANTH Physics v1.4 is LOADED - blackhole / tornado / nuke / kill / wand are ready")
			end,
		},
		["wand"] = {
			ListName = "wand",
			Description = "Give the ANTH Wand tool. Equip it, tap a small loose part to grab it, tap again to drop, tap the small THROW button on screen to throw it.",
			Aliases = {},
			Function = function(args, speaker)
				giveWand()
			end,
		},
		["unwand"] = {
			ListName = "unwand",
			Description = "Remove the ANTH Wand tool.",
			Aliases = {},
			Function = function(args, speaker)
				removeWand()
			end,
		},
	},
}

-- Chat listener for BOTH ; and / prefixes, with a 1s debounce.
-- IY's command bar / prompt calls the Functions above directly, chat does
-- NOT go through IY's handler in the same way, so this is the backup path.
-- The debounce stops IY + chat running the same command twice in a row.
local LastChatRun = {}
local function runChatCmd(cmd, arg)
	local key = cmd .. "|" .. (arg or "")
	local now = os.clock()
	if LastChatRun[key] and (now - LastChatRun[key]) < 1 then return end
	LastChatRun[key] = now
	local t = nil
	if arg then t = findPlayer(arg) end
	if cmd == "blackhole" or cmd == "bh" then
		startBH(t)
	elseif cmd == "unblackhole" or cmd == "unbh" or cmd == "stopbh" then
		stopBH()
		notify("Blackhole OFF")
	elseif cmd == "tornado" or cmd == "tor" then
		startTOR(t)
	elseif cmd == "untornado" or cmd == "untor" or cmd == "stoptor" then
		stopTOR()
		notify("Tornado OFF")
	elseif cmd == "nuke" then
		doNuke(t)
	elseif cmd == "kill" then
		doKill(t)
	elseif cmd == "stopphysics" or cmd == "stopallphysics" then
		stopBH()
		stopTOR()
		notify("Physics stopped")
	elseif cmd == "ping" then
		notify("ANTH Physics v1.4 is LOADED - blackhole / tornado / nuke / kill / wand are ready")
	elseif cmd == "wand" then
		giveWand()
	elseif cmd == "unwand" then
		removeWand()
	end
end
task.spawn(function()
	task.wait(1)
	notify("ANTH Physics v1.4 loaded - try ;ping or /ping in chat, or ;blackhole in IY")
	LocalPlayer.Chatted:Connect(function(msg)
		local first = string.sub(msg, 1, 1)
		if first ~= ";" and first ~= "/" then return end
		local parts = {}
		for w in string.gmatch(string.sub(msg, 2), "%S+") do table.insert(parts, w) end
		if #parts == 0 then return end
		runChatCmd(string.lower(parts[1]), parts[2])
	end)
end)

return Plugin
